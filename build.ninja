  command = env PSTUDIO=build/bin/pstudio bash tests/pstudio-build.sh > build/t/log/pstudio-build.log
  description = the engine inside the editor (report in build/t/log/pstudio-build.log)

build build/t/log/pstudio-build.log: e795 build/bin/pstudio build/bin/pforge

rule e796
  command = env PFORGE=build/bin/pforge bash tests/ninja.sh > build/t/log/ninja.log
  description = the committed build.ninja (report in build/t/log/ninja.log)

build build/t/log/ninja.log: e796 build/bin/pforge

rule e797
  command = env PFORGE=build/bin/pforge bash tests/run-cmd-pforge.sh > build/t/log/run-pforge.log
  description = run through pforge (report in build/t/log/run-pforge.log)

build build/t/log/run-pforge.log: e797 build/bin/pforge build/bin/plangc_s2

rule e798
  command = env PLANGC=build/bin/plangc_s2 bash tests/conformance/run.sh > build/t/log/conformance.log
  description = conformance (report in build/t/log/conformance.log)

build build/t/log/conformance.log: e798 build/bin/plangc_s2

rule e799
  command = env PLANGC=build/bin/plangc_s2 bash tests/oracle/run.sh > build/t/log/oracle.log
  description = the oracles (report in build/t/log/oracle.log)

build build/t/log/oracle.log: e799 build/bin/plangc_s2

rule e800
  command = env OUT=build/t/h/qbefp PLANGC=build/bin/plangc_s2 bash tests/qbe-fixpoint.sh > build/t/log/qbe-fixpoint.log
  description = the QBE fixed point (report in build/t/log/qbe-fixpoint.log)

build build/t/log/qbe-fixpoint.log: e800 build/bin/plangc_s2

rule e801
  command = env OUT=build/t/h/packages PLANGC=build/bin/plangc_s2 bash tests/packages.sh > build/t/log/packages.log
  description = packages (import <>) (report in build/t/log/packages.log)

build build/t/log/packages.log: e801 build/bin/plangc_s2

rule e802
  command = env PLANGC=build/bin/plangc_s2 bash tests/pforge.sh > build/t/log/pforge.log
  description = the pforge engine (report in build/t/log/pforge.log)

build build/t/log/pforge.log: e802 build/bin/plangc_s2

rule e803
  command = env OUT=build/t/h/c-suite PLANGC=build/bin/plangc_s2 bash tests/run.sh c-suite > build/t/log/c-suite.log
  description = scoreboard c-suite (report in build/t/log/c-suite.log)

build build/t/log/c-suite.log: e803 build/bin/plangc_s2

rule e804
  command = ./build/bin/floor build/t/log/c-suite.log 'score: ' 220 build/t/stamp/c-suite.floor
  description = c-suite >= 220

build build/t/stamp/c-suite.floor: e804 build/t/log/c-suite.log build/bin/floor

rule e805
  command = env OUT=build/t/h/wacct PLANGC=build/bin/plangc_s2 bash tests/run.sh wacct-valid > build/t/log/wacct.log
  description = scoreboard wacct (report in build/t/log/wacct.log)

build build/t/log/wacct.log: e805 build/bin/plangc_s2

rule e806
  command = ./build/bin/floor build/t/log/wacct.log 'wacct-valid: ' 741 build/t/stamp/wacct.floor
  description = wacct >= 741

build build/t/stamp/wacct.floor: e806 build/t/log/wacct.log build/bin/floor

rule e807
  command = /bin/sh -c 'exit 0' > build/t/stamp/test
  description = test: the corpus in C, the suite case by case, the packages' tests and the DOCTESTS

build build/t/stamp/test: e807 build/t/log/suite-c.log build/t/stamp/pscript.suite build/t/stamp/packages.suite build/t/stamp/doctest.suite

rule e808
  command = /bin/sh -c 'exit 0' > build/t/stamp/verify
  description = verify: 24 parts

build build/t/stamp/verify: e808 build/t/log/suite-c.log build/t/log/suite-qbe.log build/t/log/suite-c89.log build/t/log/gc-stress.log build/t/log/protocol.log build/t/log/knobs.log build/t/log/net-late.log build/t/log/print-atomic.log build/t/log/check.log build/t/log/pstudio-build.log build/t/log/ninja.log build/t/log/run-pforge.log build/t/log/conformance.log build/t/log/oracle.log build/t/log/qbe-fixpoint.log build/t/log/packages.log build/t/log/pforge.log build/t/stamp/c-suite.floor build/t/stamp/wacct.floor build/t/stamp/pscript.suite build/t/stamp/packages.suite build/t/stamp/doctest.suite build/stamp/compiler build/bin/pstudio

default build/stamp/compiler build/bin/pforge build/bin/pcode build/bin/pstudio
