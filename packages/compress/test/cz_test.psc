e: List<int> = [0, 0]


def ck(name: str, ok: bool):
    if ok:
        e[0] += 1
    else:
        e[1] += 1
        print("  FALHOU: " + name)


def main():
    NOMES: List<str> = ["vazio", "um byte", "repetido", "texto", "binario"]
    GZ: List<bytes> = [GZ_VAZIO, GZ_UM_BYTE, GZ_REPETIDO, GZ_TEXTO, GZ_BINARIO]
    ZL: List<bytes> = [ZL_VAZIO, ZL_UM_BYTE, ZL_REPETIDO, ZL_TEXTO, ZL_BINARIO]
    TAM: List<int> = [0, 1, 300, 1720, 1024]
    ADLER: List<int> = [1, 6422626, 3634917805, 1472757511, 3838443024]
    CRC: List<int> = [0, 3904355907, 2308380937, 795191507, 3070970918]

    for k in range(len(NOMES)):
        g = z.gzip_decompress(GZ[k])
        ck("gzip " + NOMES[k] + ": tamanho", len(g) == TAM[k])
        l = z.zlib_decompress(ZL[k])
        ck("zlib " + NOMES[k] + ": tamanho", len(l) == TAM[k])
        ck("gzip e zlib dao o mesmo (" + NOMES[k] + ")", g == l)
        ck("adler " + NOMES[k], z.adler32(g) == ADLER[k])
        ck("crc " + NOMES[k], z.crc32(g) == CRC[k])
        # ... e a ida e volta pelo nosso lado
        ck("volta gzip " + NOMES[k], z.gzip_decompress(z.gzip_compress(g)) == g)
        ck("volta zlib " + NOMES[k], z.zlib_decompress(z.zlib_compress(g)) == g)
        ck("volta deflate " + NOMES[k], z.inflate(z.deflate(g)) == g)

    # o conteudo, e nao so o tamanho
    ck("um byte e mesmo 'a'", str(z.gzip_decompress(GZ_UM_BYTE)) == "a")
    r = z.gzip_decompress(GZ_REPETIDO)
    mau = 0
    for x in r:
        if int(x) != 97:
            mau += 1
    ck("trezentos 'a'", mau == 0)
    b = z.gzip_decompress(GZ_BINARIO)
    mau2 = 0
    for i in range(1024):
        if int(b[i]) != i % 256:
            mau2 += 1
    ck("os 256 bytes na ordem", mau2 == 0)

    # ---- o que ele RECUSA, e cada recusa apanha um erro diferente ----
    #
    # Um fluxo que mente sobre si proprio nao e uma condicao do algoritmo: e o
    # ficheiro a dizer uma coisa e a ser outra, e isso LEVANTA (4.2).
    MAUS: List<str> = ["magia trocada", "metodo errado", "crc que nao bate",
                       "tamanho que nao bate", "truncado", "vazio"]
    for k in range(len(MAUS)):
        bad = corromper(GZ_TEXTO, k)
        try:
            _ = z.gzip_decompress(bad)
            ck("recusa: " + MAUS[k], False)
        catch err:
            ck("recusa: " + MAUS[k], True)

    # ... e um zlib com o cabecalho errado
    try:
        _ = z.zlib_decompress(b"\x00\x00\x00\x00\x00\x00")
        ck("zlib com cabecalho mau", False)
    catch err2:
        ck("zlib com cabecalho mau", True)

    print("compress: " + str(e[0]) + " ok, " + str(e[1]) + " falharam")


def corromper(src: bytes, qual: int) -> bytes:
    l: List<u8> = []
    for x in src:
        l.append(x)
    if qual == 0:
        l[0] = u8(0x1e)
    elif qual == 1:
        l[2] = u8(9)
    elif qual == 2:
        l[len(l) - 8] = u8(int(l[len(l) - 8]) ^ 255)
    elif qual == 3:
        l[len(l) - 4] = u8(int(l[len(l) - 4]) ^ 255)
    elif qual == 4:
        while len(l) > 12:
            _ = l.pop()
    else:
        l = []
    return bytes(l)


main()
